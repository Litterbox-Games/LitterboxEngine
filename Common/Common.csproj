<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net9.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Arch" Version="2.0.0" />
        <PackageReference Include="AscensionGameDev.Lidgren.Network" Version="1.8.0.13" />
        <PackageReference Include="Autofac" Version="8.3.0" />
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" />
        <PackageReference Include="morelinq" Version="4.4.0" />
        <PackageReference Include="Serilog" Version="4.2.1-dev-02340" />
        <PackageReference Include="Serilog.Sinks.Console" Version="6.0.1-dev-00953" />
    </ItemGroup>
    
    <ItemGroup>
        <Compile Remove="Core/AttributeAnalyzer.cs" />
        <Analyzer Include="$(IntermediateOutputPath)Common.Analyzer.dll" />
        <AnalyzerCompile Include="Core/AttributeAnalyzer.cs" />
    </ItemGroup>
    
    <Target Name="BuildAnalyzer"
            BeforeTargets="CoreCompile" 
            Inputs="@(AnalyzerCompile)" 
            Outputs="$(IntermediateOutputPath)Common.Analyzer.dll">
        
        <Csc Sources="@(AnalyzerCompile)"
             OutputAssembly="$(IntermediateOutputPath)Common.Analyzer.dll"
             TargetType="Library"
             EmitDebugInformation="true"
             DebugType="portable"
             References="@(ReferencePathWithRefAssemblies)"
             Deterministic="true"
        />
    </Target>

</Project>